<UserControl 
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PocketAlbum.Studio.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="PocketAlbum.Studio.Views.SlideshowControl"
        x:DataType="vm:MainWindowViewModel">

    <Panel>
        <DockPanel IsVisible="{Binding SelectedImage,
                              Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel DockPanel.Dock="Bottom">
                <Button Margin="10" Click="CastClick"
                        Background="White" 
                        ToolTip.Tip="Cast to receiver" >
                    <materialIcons:MaterialIcon
                        Kind="Cast"
                        Width="24"
                        Height="24" />
                </Button>
            </StackPanel>
            <Image 
                Source="{Binding SelectedImage.Image}" 
                MaxWidth="567" 
                MaxHeight="567" 
                Margin="10"
                />
        </DockPanel>
        <Panel IsVisible="{Binding SelectedImage,
                          Converter={x:Static ObjectConverters.IsNull}}">
            <TextBlock 
                Text="Select an image from the gallery" 
                FontSize="16" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center" 
                Margin="10" />
        </Panel>
    </Panel>

</UserControl>